
@PACKAGE_INIT@

if(NOT FOUND_POLYTOPE)
  set(POLYTOPE_ENABLE_MPI "@POLYTOPE_ENABLE_MPI@")
  set(POLYTOPE_ENABLE_BOOST "@POLYTOPE_ENABLE_BOOST@")
  set(POLYTOPE_ENABLE_PYTHON "@POLYTOPE_ENABLE_PYTHON@")
  set(POLYTOPE_ENABLE_SILO "@POLYTOPE_ENABLE_SILO@")
  set(POLYTOPE_ENABLE_TETGEN "@POLYTOPE_ENABLE_TETGEN@")
  set(POLYTOPE_ENABLE_C "@POLYTOPE_ENABLE_C@")
  set(POLYTOPE_INSTALL_PREFIX "@CMAKE_INSTALL_PREFIX@" CACHE PATH "Polytope install prefix")
  if (POLYTOPE_ENABLE_PYTHON)
    set(POLYTOPE_SITE_PACKAGES_PATH "@POLYTOPE_SITE_PACKAGES_PATH@" CACHE PATH "Polytope site-packages path")
  endif()
  set(POLYTOPE_INCLUDE_DIRS "${POLYTOPE_INSTALL_PREFIX}/@POLYTOPE_INSTALL_INCLUDE_DIR@")

  set(FP_TPLS "@FP_TPLS@")
  set(FP_DIRS "@FP_DIRS@")
  foreach(tpl dir in ZIP_LISTS FP_TPLS FP_DIRS)
    if(NOT ${tpl}_DIR)
      set(${tpl}_DIR ${dir} CACHE PATH "")
    endif()
    if(NOT TARGET ${tpl})
      find_package(${tpl} REQUIRED QUIET NO_DEFAULT_PATH)
    endif()
  endforeach()

  include("${CMAKE_CURRENT_LIST_DIR}/polytope-targets.cmake")
  set(POLYTOPE_FOUND TRUE)
endif()
